#!/bin/bash
# Agentic Workflow CLI

set -euo pipefail

AGENTIC_HOME="${AGENTIC_HOME:-$HOME/.agentic}"

# APP SOURCE vs STATE split.
#   AGENTIC_HOME — STATE only (queue/worktrees/diffs/logs/settings/secrets).
#   AGENTIC_APP  — the app SOURCE tree (bin/lib/agents/profiles/venv).
# Native install: both live in ~/.agentic, so AGENTIC_APP defaults to
# AGENTIC_HOME and nothing changes. Docker sets AGENTIC_APP=/opt/agentic (baked,
# read-only) so the container never needs to write source into the state mount.
# AGENTIC_PYTHON is the interpreter (the baked venv in Docker, the local venv
# natively). Exported so every sourced lib and child process inherits them.
export AGENTIC_HOME
export AGENTIC_APP="${AGENTIC_APP:-$AGENTIC_HOME}"
export AGENTIC_PYTHON="${AGENTIC_PYTHON:-$AGENTIC_APP/venv/bin/python3}"

source "$AGENTIC_APP/lib/config.sh"
source "$AGENTIC_APP/lib/utils.sh"
source "$AGENTIC_APP/lib/init.sh"
source "$AGENTIC_APP/lib/claude-api.sh"
source "$AGENTIC_APP/lib/doc.sh"
source "$AGENTIC_APP/lib/apply.sh"
source "$AGENTIC_APP/lib/plan.sh"
source "$AGENTIC_APP/lib/worker.sh"
source "$AGENTIC_APP/lib/queue.sh"

# Walk parent_request_id chain to find the root non-review job's ID.
# All review jobs (and reviews of reviews) commit onto agentic/<root-id>.
_find_root_branch_id() {
  local current_id="$1"
  local seen=""
  while [[ -n "$current_id" ]]; do
    case "$seen" in *" $current_id "*) echo "$current_id"; return ;; esac
    seen="$seen $current_id "
    local job_file
    job_file=$(find "${AGENTIC_QUEUE_DIR}" -name "*.json" \
      -exec grep -l "\"id\": \"${current_id}\"" {} + 2>/dev/null | head -1)
    [[ -z "$job_file" ]] && { echo "$current_id"; return; }
    local jtype
    jtype=$(jq -r '.job_type // empty' "$job_file")
    [[ "$jtype" != "review" ]] && { echo "$current_id"; return; }
    current_id=$(jq -r '.parent_request_id // empty' "$job_file")
  done
  echo "$1"
}

_main() {
case "${1:-}" in

  # ── Setup & configuration ────────────────────────────────────────────────────
  init)
    agentic-init
    ;;
  config)
    agentic-config
    ;;
  switch)
    shift
    agentic-switch "${@:-}"
    ;;

  # ── Review workflow ──────────────────────────────────────────────────────────
  accept)
    shift
    agentic-accept "${@:-}"
    ;;
  reject)
    shift
    agentic-reject "${@:-}"
    ;;

  # ── Documentation & planning ─────────────────────────────────────────────────
  doc)
    agentic-doc
    ;;
  doc-gen)
    agentic-doc-gen
    ;;
  plan)
    plan
    ;;

  # ── Queue commands ───────────────────────────────────────────────────────────

  # submit "<request>" [--repo PATH] [--model-hint HINT] [--priority N] [--after JOB-ID]
  submit)
    shift
    local _sq_request="" _sq_repo="$PWD" _sq_hint="auto" _sq_priority=0 _sq_after=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --repo)        _sq_repo="$2";     shift 2 ;;
        --model-hint)  _sq_hint="$2";    shift 2 ;;
        --priority)    _sq_priority="$2"; shift 2 ;;
        --after)       _sq_after="$2";    shift 2 ;;
        *)             _sq_request="$1"; shift ;;
      esac
    done
    if [[ -z "$_sq_request" ]]; then
      echo "❌ Usage: agentic submit \"<request>\" [--repo PATH] [--priority N] [--after JOB-ID]"
      exit 1
    fi
    local _sq_id
    _sq_id=$(queue_submit "$_sq_request" "$_sq_repo" "$_sq_hint" "$_sq_priority" "$_sq_after") || exit 1
    echo "✅ Submitted $_sq_id (pending)${_sq_after:+ — chains from $_sq_after}"
    ;;

  # inbox [--state STATE] [--json]
  inbox)
    shift
    local _ib_state="" _ib_json=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --state) _ib_state="$2"; shift 2 ;;
        --json)  _ib_json="json"; shift ;;
        *)       shift ;;
      esac
    done
    _queue_init

    local _ib_states
    if [[ -n "$_ib_state" ]]; then
      _ib_states=("$_ib_state")
    else
      _ib_states=("pending" "running" "done" "failed" "abandoned" "cancelled")
    fi

    if [[ "$_ib_json" == "json" ]]; then
      local _ib_tmpfile
      _ib_tmpfile=$(mktemp /tmp/agentic_inbox_XXXXXX.json)
      for _ib_s in "${_ib_states[@]}"; do
        local _ib_dir="${AGENTIC_QUEUE_DIR}/${_ib_s}"
        [[ -d "$_ib_dir" ]] || continue
        for _ib_f in "$_ib_dir"/*.json; do
          [[ -f "$_ib_f" ]] || continue
          jq --arg s "$_ib_s" '. + {queue_state: $s}' "$_ib_f" >> "$_ib_tmpfile"
        done
      done
      if [[ -s "$_ib_tmpfile" ]]; then
        jq -s '.' "$_ib_tmpfile"
      else
        echo "[]"
      fi
      rm -f "$_ib_tmpfile"
    else
      local _ib_any=false
      for _ib_s in "${_ib_states[@]}"; do
        local _ib_dir="${AGENTIC_QUEUE_DIR}/${_ib_s}"
        [[ -d "$_ib_dir" ]] || continue
        local _ib_printed_header=false
        for _ib_f in "$_ib_dir"/*.json; do
          [[ -f "$_ib_f" ]] || continue
          if [[ "$_ib_printed_header" == false ]]; then
            echo "── ${_ib_s} ──────────────────────────────────────"
            _ib_printed_header=true
            _ib_any=true
          fi
          local _ib_id _ib_req _ib_at
          _ib_id=$(jq -r '.id' "$_ib_f")
          _ib_req=$(jq -r '.request' "$_ib_f")
          _ib_at=$(jq -r '.submitted_at' "$_ib_f")
          local _ib_short="${_ib_req:0:50}"
          [[ ${#_ib_req} -gt 50 ]] && _ib_short="${_ib_short}..."
          local _ib_when
          _ib_when=$(_queue_relative_time "$_ib_at")
          echo "  $_ib_id [$_ib_s] \"$_ib_short\" submitted $_ib_when"
        done
        [[ "$_ib_printed_header" == true ]] && echo ""
      done
      [[ "$_ib_any" == false ]] && echo "No jobs found."
    fi
    ;;

  # cancel <job-id>
  cancel)
    local _cjob="${2:-}"
    if [[ -z "$_cjob" ]]; then
      echo "❌ Usage: agentic cancel <job-id>"
      exit 1
    fi
    _queue_init
    local _cfound=""
    for _cf in "${AGENTIC_QUEUE_DIR}/pending/"*.json; do
      [[ -f "$_cf" ]] || continue
      local _cid
      _cid=$(jq -r '.id' "$_cf")
      if [[ "$_cid" == "$_cjob" ]]; then
        _cfound="$_cf"
        break
      fi
    done
    if [[ -z "$_cfound" ]]; then
      echo "❌ Job not found in pending/: $_cjob"
      echo "   Only pending jobs can be cancelled."
      exit 1
    fi
    queue_complete "$_cfound" "cancelled" "cancelled by user"
    echo "✅ Cancelled: $_cjob"
    ;;

  # claim — atomically claim one pending job for a backend, print ONLY its id.
  # Used by the server-side dispatcher: it claims here, then spawns
  # `worker-once --id <id> --backend <b>` against the moved running/ file.
  #   agentic claim --backend local|cloud [--exclude-chain-roots id,id,...]
  claim)
    shift
    _queue_init
    local _cl_path
    if ! _cl_path=$(queue_claim "$@"); then
      exit 1   # nothing claimable for this backend/filter
    fi
    jq -r '.id' "$_cl_path"   # stdout: the claimed job id, and nothing else
    exit 0
    ;;

  # worker-once — run one job in an isolated worktree.
  #   no flags          : claim the next pending job then run it (CLI back-compat).
  #   --id <job_id>     : the dispatcher already claimed it (it's in running/);
  #                       SKIP queue_claim and run THAT job.
  #   --backend l|cloud : route this process — local sets AGENTIC_LOCAL=1, cloud
  #                       unsets it (uses AGENTIC_MODEL) — so one server drives
  #                       both pools.
  worker-once)
    shift
    _queue_init

    local _warg_id="" _warg_backend=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --id)         _warg_id="$2"; shift 2 ;;
        --id=*)       _warg_id="${1#*=}"; shift ;;
        --backend)    _warg_backend="$2"; shift 2 ;;
        --backend=*)  _warg_backend="${1#*=}"; shift ;;
        *) echo "❌ worker-once: unknown argument '$1'" >&2; exit 2 ;;
      esac
    done

    # Per-process backend routing (mirrors serve.py's per-spawn env).
    case "$_warg_backend" in
      local) export AGENTIC_LOCAL=1 ;;
      cloud) unset AGENTIC_LOCAL ;;        # cloud → claude CLI via AGENTIC_MODEL
      "")    : ;;                          # no override — honour inherited env
      *) echo "❌ worker-once: --backend must be 'local' or 'cloud'" >&2; exit 2 ;;
    esac

    local _wjob_path
    if [[ -n "$_warg_id" ]]; then
      # Dispatcher path: the job is already claimed and in running/ — find by id.
      _wjob_path=$(grep -rlE "\"id\":[[:space:]]*\"${_warg_id}\"" \
        "${AGENTIC_QUEUE_DIR}/running/" 2>/dev/null | head -1)
      if [[ -z "$_wjob_path" || ! -f "$_wjob_path" ]]; then
        echo "❌ worker-once: no running/ job found for id '$_warg_id'" >&2
        exit 1
      fi
    else
      # CLI back-compat: claim the next pending job ourselves.
      if ! _wjob_path=$(queue_claim); then
        echo "No pending jobs."
        exit 0
      fi
    fi

    local _wid _wrequest _wtarget _wmodel
    _wid=$(jq -r '.id' "$_wjob_path")
    _wrequest=$(jq -r '.request' "$_wjob_path")
    _wtarget=$(jq -r '.target_repo' "$_wjob_path")
    _wmodel=$(jq -r '.model_hint // empty' "$_wjob_path")

    # Resolve the ACTUAL model this run will use (mode + the global Settings
    # model), and record it on the job so the UI can show "ran on X" instead of
    # the ambiguous 'auto'. Model is resolved at RUN time from Settings, not at
    # submit time. worker.sh applies the same resolution.
    local _wresolved
    if [[ "${AGENTIC_LOCAL:-}" == "1" ]]; then
      _wresolved="${AGENTIC_LOCAL_MODEL:-qwen-coder:latest}"
      _wresolved="local · ${_wresolved}"
    else
      local _cm="${AGENTIC_MODEL:-auto}"
      _wresolved="cloud · ${_cm}"
    fi
    # Write resolved_model into the running job JSON (best-effort).
    local _wtmp
    _wtmp=$(mktemp) && jq --arg m "$_wresolved" '.resolved_model = $m' "$_wjob_path" > "$_wtmp" 2>/dev/null \
      && mv "$_wtmp" "$_wjob_path" 2>/dev/null || rm -f "$_wtmp" 2>/dev/null

    echo "🔧 Claimed: $_wid"
    echo "   Request: ${_wrequest:0:80}"
    echo "   Repo:    $_wtarget"
    echo "   Model:   $_wresolved"
    echo ""

    local _wworktree="${AGENTIC_WORKTREES_DIR}/${_wid}"
    local _wjob_type
    _wjob_type=$(jq -r '.job_type // empty' "$_wjob_path")

    local _wparent_id
    _wparent_id=$(jq -r '.parent_request_id // empty' "$_wjob_path")

    # Export profile so utils.sh, apply.sh, and other sourced scripts can read it
    export AGENTIC_PROFILE
    AGENTIC_PROFILE=$(jq -r '.profile // "typescript"' "$_wjob_path")

    # Review jobs commit onto the root (non-review) job's branch — resolve it by
    # walking up parent_request_id until we find a non-review job.
    # Reviews-of-reviews all land on agentic/<root-job-id>, same as direct reviews.
    local _wroot_branch_id="$_wid"
    if [[ "$_wjob_type" == "review" && -n "$_wparent_id" ]]; then
      _wroot_branch_id=$(_find_root_branch_id "$_wparent_id")
    fi

    local _wbranch _wnew_branch
    if [[ "$_wjob_type" == "review" ]] && \
       git -C "$_wtarget" show-ref --verify --quiet "refs/heads/agentic/${_wroot_branch_id}" 2>/dev/null; then
      _wbranch="agentic/${_wroot_branch_id}"
      _wnew_branch=""
      echo "🔍 Review job — committing onto: $_wbranch"
    else
      _wbranch="agentic/${_wid}"
      _wnew_branch="$_wbranch"
    fi

    # Determine base branch for new-branch jobs
    local _wbase_branch=""
    if [[ -n "$_wnew_branch" ]]; then
      if [[ -n "$_wparent_id" ]] && \
         git -C "$_wtarget" show-ref --verify --quiet "refs/heads/agentic/${_wparent_id}" 2>/dev/null; then
        _wbase_branch="agentic/${_wparent_id}"
        echo "🔗 Chaining from: $_wbase_branch"
      else
        _wbase_branch=$(git -C "$_wtarget" symbolic-ref --short HEAD 2>/dev/null || echo "HEAD")
      fi
    fi

    # Clean up stale worktree from previous run of this job
    if [[ -d "$_wworktree" ]]; then
      echo "♻️  Removing stale worktree from previous run..."
      git -C "$_wtarget" worktree remove "$_wworktree" --force 2>/dev/null || rm -rf "$_wworktree"
    fi

    # For review jobs: release the parent's worktree so its branch can be checked out here.
    # The branch and its commit are preserved — only the filesystem checkout is removed.
    if [[ "$_wjob_type" == "review" && -n "$_wparent_id" ]]; then
      local _wparent_wt="${AGENTIC_WORKTREES_DIR}/${_wparent_id}"
      if [[ -d "$_wparent_wt" ]]; then
        echo "♻️  Releasing parent worktree to free branch for review..."
        git -C "$_wtarget" worktree remove "$_wparent_wt" --force 2>/dev/null || rm -rf "$_wparent_wt"
      fi
    fi
    # Only clean up a stale branch if we own one (regular jobs, not review jobs)
    if [[ -n "$_wnew_branch" ]] && \
       git -C "$_wtarget" show-ref --verify --quiet "refs/heads/${_wnew_branch}" 2>/dev/null; then
      echo "♻️  Removing stale branch from previous run..."
      git -C "$_wtarget" branch -D "$_wnew_branch" 2>/dev/null || true
    fi

    if [[ -n "$_wnew_branch" ]]; then
      if ! git -C "$_wtarget" worktree add "$_wworktree" -b "$_wnew_branch" "$_wbase_branch" 2>&1; then
        echo "❌ Failed to create worktree at $_wworktree"
        queue_complete "$_wjob_path" "failed" "worktree creation failed"
        _queue_notify "agentic: failed" "Job $_wid — worktree creation failed"
        exit 1
      fi
    else
      if ! git -C "$_wtarget" worktree add "$_wworktree" "$_wbranch" 2>&1; then
        echo "❌ Failed to create worktree at $_wworktree"
        queue_complete "$_wjob_path" "failed" "worktree creation failed"
        _queue_notify "agentic: failed" "Job $_wid — worktree creation failed"
        exit 1
      fi
    fi

    # When chaining, merge the repo's main branch so commits made to main after the
    # parent job branched (e.g. assets, CLAUDE.md updates) are visible in this worktree.
    if [[ -n "$_wparent_id" && -n "$_wnew_branch" ]]; then
      local _wmain
      _wmain=$(jq -r '.base_branch // empty' "$_wjob_path")
      [[ -z "$_wmain" ]] && _wmain=$(git -C "$_wtarget" symbolic-ref --short HEAD 2>/dev/null || echo "master")
      if [[ "$_wbase_branch" != "$_wmain" ]] && \
         git -C "$_wtarget" show-ref --verify --quiet "refs/heads/${_wmain}" 2>/dev/null; then
        if git -C "$_wworktree" merge --no-edit --no-ff "$_wmain" -m "Merge ${_wmain} into chain" 2>/dev/null; then
          echo "🔀 Merged ${_wmain} into chain (new commits since parent branched)"
        fi
      fi
    fi

    echo "🌿 Worktree: $_wworktree"
    echo "🌿 Branch:   $_wbranch"
    echo ""

    # Record the branch tip before the agent runs so we can squash its commits
    local _wbase_sha
    _wbase_sha=$(git -C "$_wworktree" rev-parse HEAD 2>/dev/null || echo "")

    # Run the Claude Code agent inside the worktree
    # Save the JSONL log to LOGS_DIR (outside the worktree) to avoid merge conflicts
    mkdir -p "${AGENTIC_HOME}/logs"
    local _wlog="${AGENTIC_HOME}/logs/${_wid}.jsonl"
    local _wrc=0
    (
      cd "$_wworktree" || exit 1
      export AGENTIC_TARGET_REPO="$_wtarget"
      run_worker_agent "$_wrequest" "$_wlog" "$_wmodel"
    ) || _wrc=$?

    if [[ $_wrc -eq 0 ]]; then
      # Squash all agent commits + any unstaged changes into one atomic commit.
      # This guarantees one commit per job regardless of how many the agent made.
      if [[ -n "$_wbase_sha" ]]; then
        git -C "$_wworktree" add -A 2>/dev/null || true
        git -C "$_wworktree" reset --soft "$_wbase_sha" 2>/dev/null || true
        git -C "$_wworktree" add -A 2>/dev/null || true
        if ! git -C "$_wworktree" diff --cached --quiet 2>/dev/null; then
          git -C "$_wworktree" commit -m "agentic: $_wid" --no-verify 2>/dev/null || true
          echo "📦 Squashed to single commit"
        fi
      fi

      local _wsha
      _wsha=$(git -C "$_wworktree" rev-parse --short HEAD 2>/dev/null || echo "unknown")
      local _wsummary="applied to ${_wbranch}, SHA ${_wsha}"
      queue_complete "$_wjob_path" "done" "$_wsummary"

      # For review jobs, append this SHA to the parent job's reviews[] array
      if [[ "$_wjob_type" == "review" && -n "$_wparent_id" ]]; then
        local _wparent_file
        _wparent_file=$(find "${AGENTIC_QUEUE_DIR}" -name "*.json" | \
          xargs grep -l "\"id\": \"${_wparent_id}\"" 2>/dev/null | head -1)
        if [[ -n "$_wparent_file" ]]; then
          local _wnow
          _wnow=$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")
          local _wentry="{\"sha\":\"${_wsha}\",\"job_id\":\"${_wid}\",\"at\":\"${_wnow}\"}"
          local _wtmp
          _wtmp=$(mktemp)
          jq --argjson entry "$_wentry" \
            'if has("reviews") then .reviews += [$entry] else .reviews = [$entry] end' \
            "$_wparent_file" > "$_wtmp" && mv "$_wtmp" "$_wparent_file"
          echo "📝 Review SHA recorded on parent job"
        fi
      fi

      echo ""
      echo "✅ Job complete: $_wid"
      echo "   Branch: $_wbranch"
      echo "   SHA:    $_wsha"
      echo "   Inspect: cd $_wworktree"
      _queue_notify "agentic: done" "Job $_wid complete — $_wbranch"
    else
      queue_complete "$_wjob_path" "failed" "agent exited with code ${_wrc}"
      echo ""
      echo "❌ Job failed: $_wid (exit code $_wrc)"
      echo "   Worktree preserved: $_wworktree"
      _queue_notify "agentic: failed" "Job $_wid failed — see $_wworktree"
      exit 1
    fi
    ;;

  # serve [PORT] | serve stop | serve status
  serve)
    local _spid_file="${AGENTIC_HOME}/serve.pid"
    case "${2:-start}" in
      stop)
        if [[ ! -f "$_spid_file" ]]; then
          echo "❌ Server is not running (no PID file found)"
          exit 1
        fi
        local _scontent _spid
        _scontent=$(cat "$_spid_file")
        _spid="${_scontent%%:*}"
        if kill -0 "$_spid" 2>/dev/null; then
          kill "$_spid"
          rm -f "$_spid_file"
          echo "✅ Stopped server (PID $_spid)"
        else
          echo "⚠️  Process $_spid not found — removing stale PID file"
          rm -f "$_spid_file"
          exit 1
        fi
        ;;
      status)
        if [[ ! -f "$_spid_file" ]]; then
          echo "Server is not running"
          exit 1
        fi
        local _scontent _spid _sport
        _scontent=$(cat "$_spid_file")
        _spid="${_scontent%%:*}"
        _sport="${_scontent##*:}"
        if kill -0 "$_spid" 2>/dev/null; then
          echo "✅ Running (PID $_spid) → http://localhost:${_sport}"
        else
          echo "⚠️  Stale PID file — run: agentic serve stop"
          exit 1
        fi
        ;;
      start|[0-9]*)
        local _sport_arg=""
        [[ "${2:-}" =~ ^[0-9]+$ ]] && _sport_arg="${2}"
        exec "${AGENTIC_PYTHON}" "$AGENTIC_APP/lib/serve.py" ${_sport_arg:+"$_sport_arg"}
        ;;
      --local|--local=*)
        # agentic serve --local [MODEL]
        # Priority: --local=model > AGENTIC_LOCAL_MODEL env var > default
        local _lmodel="${AGENTIC_LOCAL_MODEL:-qwen-coder:latest}"
        [[ "${2}" == --local=* ]] && _lmodel="${2#--local=}"
        [[ -n "${3:-}" ]] && _lmodel="$3"
        export AGENTIC_LOCAL=1
        export AGENTIC_LOCAL_MODEL="$_lmodel"
        echo "🏠 Local mode: $_lmodel"
        exec "${AGENTIC_PYTHON}" "$AGENTIC_APP/lib/serve.py"
        ;;
      *)
        exec "${AGENTIC_PYTHON}" "$AGENTIC_APP/lib/serve.py"
        ;;
    esac
    ;;

  # ── Version & help ───────────────────────────────────────────────────────────
  --version|-v)
    echo "agentic v2.0.0"
    echo "Engine: Claude Code agent"
    echo "Home:   $AGENTIC_HOME"
    ;;

  --help|-h)
    cat <<HELP
Agentic — AI-powered async development workflow

SETUP:
  agentic init              Initialize project (CLAUDE.md, .gitignore)
  agentic config            Configure settings
  agentic switch [anthropic|ollama|status]

QUEUE WORKFLOW (primary):
  agentic submit "<request>" [--repo PATH] [--priority N] [--after JOB-ID]
  agentic inbox [--state STATE] [--json]
  agentic cancel <job-id>
  agentic worker-once       Claim and run one pending job via Claude agent
  agentic serve [PORT]      Start dashboard at http://localhost:4080
  agentic serve stop
  agentic serve status

REVIEW:
  agentic accept [JOB-ID]   Merge the job's branch into your current branch
  agentic reject [JOB-ID]   Discard the job's branch and worktree

DOCUMENTATION:
  agentic doc               Edit CLAUDE.md in \$EDITOR
  agentic doc-gen           Auto-generate CLAUDE.md from project analysis
  agentic plan              Create agile plan from a request

EXAMPLES:
  agentic submit "Add a debounced search hook" --repo ~/my-project
  agentic serve &
  # review jobs in browser, then:
  agentic accept j_xxx
HELP
    ;;

  *)
    echo "❌ Unknown command: ${1:-}"
    echo "Run 'agentic --help' for usage"
    exit 1
    ;;

esac
}

_main "$@"
