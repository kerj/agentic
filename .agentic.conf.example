# Agentic configuration
# Copy to .agentic.conf and fill in values
# This file is gitignored — never commit .agentic.conf

# Optional: only needed for `agentic plan` and `agentic doc-gen`
# The worker agent uses the `claude` CLI which handles its own authentication.
export ANTHROPIC_API_KEY=""
export AGENTIC_MODEL="claude-opus-4-7"
export ANTHROPIC_BASE_URL="https://api.anthropic.com"
